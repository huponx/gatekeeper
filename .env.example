ENV=local
GATEKEEPER_PUBLIC_URL=http://localhost:8081
GATEKEEPER_UI_ORIGINS=http://localhost:3000   # web apps allowed to call this gateway from a browser, comma separated
PORT=8081
GATEKEEPER_IDENTITY_ISSUER=http://localhost:8080
GATEKEEPER_CLIENT_ID=gatekeeper-dev
GATEKEEPER_CLIENT_SECRET=CHANGE_ME
GATEKEEPER_AUDIENCE=gatekeeper-dev
GATEKEEPER_SESSION_KEY=k1:CHANGE_ME_BASE64_32_BYTES   # openssl rand -base64 32
GATEKEEPER_ROUTES_FILE=./routes.local.yaml   # make routes
# largest message accepted from an upstream: above DICTIONARY_EXPORT_MAX_BYTES_CEILING (10 MiB) plus a margin
GATEKEEPER_UPSTREAM_MAX_RECV_BYTES=16777216
REDIS_HOST=localhost
